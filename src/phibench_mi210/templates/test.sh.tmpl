#!/usr/bin/env bash
# Verifier for @@TASK_ID@@. Scope: @@SCOPE_TEXT@@. Hardware: AMD Instinct MI210 (see ref_speedup.caveat.md).
# reward = min(1.0, ln(speedup/ref_speedup)/ln(ref_speedup)) if speedup > ref_speedup else 0.0
# Modes: candidate | noop | oracle | baseline2 | negative.
set -uo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/rocm/bin"
git config --global --add safe.directory '*' 2>/dev/null || true
TESTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO=/app/repo
LOG=/logs/verifier; mkdir -p "$LOG"; export WRO_LOG="$LOG"
MODE="${KERNELBENCH_VERIFY_MODE:-candidate}"
SCOPE=(@@SCOPE_BASH@@)
BANNED=(@@BANNED_BASH@@)

HARD=(); add_hard(){ HARD+=("$1"); }
scope_ok=true; hardware_ok=true; benchmark_ok=true; ban_ok=true
corr_frac=0.0; base_ms=-1; cand_ms=-1; speedup=0; ref_speedup=1.0

cd "$REPO" 2>/dev/null || add_hard "repo_missing"

# ---- apply the reference patch of the mode (candidate and noop: no patch) ----
if [ "$MODE" = "oracle" ] && [ -n "${KERNELBENCH_ORACLE_PATCH:-}" ]; then
  git -C "$REPO" apply -p1 "$KERNELBENCH_ORACLE_PATCH" 2>"$LOG/oracle_apply.log" || add_hard "oracle_apply_failed"; fi
if [ "$MODE" = "baseline2" ] && [ -n "${KERNELBENCH_BASELINE2_PATCH:-}" ]; then
  git -C "$REPO" apply -p1 "$KERNELBENCH_BASELINE2_PATCH" 2>"$LOG/baseline2_apply.log" || add_hard "baseline2_apply_failed"; fi
if [ "$MODE" = "negative" ] && [ -n "${KERNELBENCH_NEGATIVE_PATCH:-}" ]; then
  git -C "$REPO" apply -p1 "$KERNELBENCH_NEGATIVE_PATCH" 2>"$LOG/negative_apply.log" || add_hard "negative_apply_failed"; fi

# ---- scope gate: only the scope files may change in /app/repo ----
git -C "$REPO" status --porcelain 2>/dev/null | awk '{print $2}' > "$LOG/changed_files.txt"
while IFS= read -r ff; do
  [ -z "$ff" ] && continue
  keep=false
  for s in "${SCOPE[@]}"; do [ "$ff" = "$s" ] && keep=true; done
  case "$ff" in *__pycache__*|*.pyc) keep=true;; esac
  [ "$keep" = true ] || { scope_ok=false; add_hard "out_of_scope_edit:$ff"; }
done < "$LOG/changed_files.txt"

# ---- source scan on ADDED lines: no library route-around, no reach into the verifier ----
: > "$LOG/added_lines.txt"
for s in "${SCOPE[@]}"; do
  git -C "$REPO" diff HEAD -- "$s" 2>/dev/null | grep '^+' | grep -v '^+++' >> "$LOG/added_lines.txt" || true
done
for tok in "${BANNED[@]}" "/tests/" "compute_reward" "reward.json"; do
  if grep -Fq "$tok" "$LOG/added_lines.txt"; then ban_ok=false; add_hard "banned_token:$tok"; fi
done

# ---- the anchor: tests/ref_speedup.txt, else the in-image manifest, else 1.0 (a hard gate below) ----
if [ -f "$TESTS_DIR/ref_speedup.txt" ]; then
  ref_speedup="$(tr -dc '0-9.' < "$TESTS_DIR/ref_speedup.txt")"
elif [ -f /opt/verifier-correctness-manifest.json ]; then
  ref_speedup="$(python3 -c "import json;print(json.load(open('/opt/verifier-correctness-manifest.json')).get('ref_speedup',1.0))" 2>/dev/null || echo 1.0)"
fi

# ---- the runtime contract: wrong GPU or wrong runtime is a loud hard fail, never a score ----
if [ "${#HARD[@]}" -eq 0 ]; then
  ( cd "$TESTS_DIR" && python3 grade.py identity ) > "$LOG/identity.out" 2>&1 \
    || { hardware_ok=false; add_hard "runtime_identity_failed"; }
fi

# ---- correctness: every case must pass ----
if [ "${#HARD[@]}" -eq 0 ]; then
  ( cd "$TESTS_DIR" && python3 grade.py correctness ) > "$LOG/correctness.out" 2>&1
  corr_frac="$(grep GRADE_RESULT "$LOG/correctness.out" | tail -1 | python3 -c "import json,sys
try: print(json.loads(sys.stdin.read().split('GRADE_RESULT ',1)[1]).get('correctness_frac',0.0))
except Exception: print('0.0')" 2>/dev/null || echo 0.0)"
fi

# ---- timing, only if fully correct: paired ABBA blocks, candidate against the baseline at HEAD ----
if [ "$(python3 -c "print(1 if $corr_frac>=1.0 else 0)" 2>/dev/null || echo 0)" = "1" ] && [ "${#HARD[@]}" -eq 0 ]; then
  ( cd "$TESTS_DIR" && python3 grade.py timing ) > "$LOG/timing.out" 2>&1 \
    || { benchmark_ok=false; add_hard "timing_failed"; }
  read -r base_ms cand_ms speedup <<<"$(grep GRADE_RESULT "$LOG/timing.out" | tail -1 | python3 -c "import json,sys
try:
    d=json.loads(sys.stdin.read().split('GRADE_RESULT ',1)[1]); print(d['baseline_ms'],d['candidate_ms'],d['speedup'])
except Exception: print('-1 -1 0')" 2>/dev/null || echo '-1 -1 0')"
fi

export WRO_MODE="$MODE" WRO_HARD="${HARD[*]:-}" WRO_CORR_FRAC="$corr_frac" WRO_BASE_MS="$base_ms" \
       WRO_CAND_MS="$cand_ms" WRO_SPEEDUP="$speedup" WRO_REF="$ref_speedup" WRO_SCOPE="$scope_ok" \
       WRO_HARDWARE="$hardware_ok" WRO_BENCH="$benchmark_ok" WRO_BAN="$ban_ok"
python3 "$TESTS_DIR/compute_reward.py"
